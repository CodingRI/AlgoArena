# Copy to .env or .env.extension (both are gitignored via .env*).
# Vite only reads variables prefixed with VITE_.
#
# Where to get these: Render Dashboard → your Web Service (algoarena-api)
# → copy the URL at the top of the page, e.g. https://algoarena-api-xxxx.onrender.com
#
# REST API (https, path /api):
VITE_API_BASE=https://YOUR-RENDER-SERVICE.onrender.com/api
#
# WebSocket (wss, path /ws):
VITE_WS_URL=wss://YOUR-RENDER-SERVICE.onrender.com/ws
