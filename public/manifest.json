{
  "manifest_version": 3,
  "name": "AlgoArena",
  "version": "1.0.0",
  "description": "Collaborative problem-solving on LeetCode with real-time chat, voice, and shared drawing.",
  "homepage_url": "https://github.com/CodingRI/AlgoArena",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "AlgoArena",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*",
        "https://www.leetcode.com/*",
        "https://leetcode.cn/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://www.leetcode.com/*",
    "https://leetcode.cn/*",
    "https://algoarena-rc9v.onrender.com/*",
    "wss://algoarena-rc9v.onrender.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "fonts/*", "icons/*"],
      "matches": ["https://leetcode.com/*", "https://www.leetcode.com/*", "https://leetcode.cn/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
